DATABASE_URL=postgresql://aram:aram@localhost:5433/aram?schema=preview
JWT_SECRET=change-me-in-production
PORT=4000
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# console = log OTP to the server console and return it in the response (preview only)
# msg91 = send via MSG91 (needs MSG91_AUTH_KEY / MSG91_TEMPLATE_ID)
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=aram-photos
S3_ACCESS_KEY=aram
S3_SECRET_KEY=aramsecret
